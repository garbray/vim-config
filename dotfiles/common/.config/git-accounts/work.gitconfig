# Work GitHub identity, for every repo under ~/workspace/work/. Included after
# personal.gitconfig, so it overrides it. Email and ssh key are machine-local
# (not in this public repo): ~/.config/git/work.gitconfig, created by
# install/common/git.sh.
[url "git@github.com:"]
	insteadOf = https://github.com/
[include]
	path = ~/.config/git/work.gitconfig
